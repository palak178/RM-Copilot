# Copy to `.env` and fill in. NEVER commit the real .env.
# Settings are read via pydantic-settings with the prefix RM_COPILOT_ (plus the
# Anthropic SDK's own ANTHROPIC_API_KEY). See src/rm_copilot/config.

# --- LLM (provider-agnostic; required at milestone M4+) ---
RM_COPILOT_LLM_PROVIDER=gemini              # gemini | anthropic (real) | mock (tests) | openai (stub)
RM_COPILOT_LLM_MODEL=gemini-3.1-flash-lite  # gemini-3.1-flash-lite (default) | claude-opus-4-8 (anthropic)
RM_COPILOT_LLM_API_KEY=                 # optional; if unset, the provider's own env var is used
GEMINI_API_KEY=                         # used by the Gemini provider when LLM_API_KEY is unset
ANTHROPIC_API_KEY=                      # used by the Anthropic provider when LLM_API_KEY is unset

# --- Data / reproducibility ---
RM_COPILOT_DB_PATH=./var/rm_copilot.db  # seeded SQLite artifact (gitignored)
RM_COPILOT_SEED=42                       # fixed seed -> deterministic dataset
RM_COPILOT_CUSTOMER_COUNT=500            # synthetic customers (data-model §5)

# --- Behaviour ---
RM_COPILOT_LOCALE=en_IN                  # default message locale: en_IN|hi_IN|hi_en
RM_COPILOT_TOP_N=10                      # default shortlist size (ranking)
RM_COPILOT_MAX_TOOL_CALLS=20             # bounded agent loop per turn

# --- Observability ---
RM_COPILOT_LOG_LEVEL=INFO
